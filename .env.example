# ==============================================================================
# NEARMISS Environment Variables Configuration
# ==============================================================================

# Backend FastAPI Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated URLs, or * for open access)
# Examples: https://thakursahab9910.github.io,https://nearmiss-vishesh9910.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Frontend API Endpoint Integration
# Set this to your deployed backend URL (Render, Railway, AWS ECS, or Fly.io)
# In the frontend, this can also be set directly in the UI modal or via localStorage
VITE_API_URL=https://nearmiss-api.onrender.com
REACT_APP_API_URL=https://nearmiss-api.onrender.com
NEARMISS_API_URL=https://nearmiss-api.onrender.com

# Model Artifacts & Paths
MODEL_DIR=models
DATA_DIR=data
CONFIG_PATH=config.yaml
